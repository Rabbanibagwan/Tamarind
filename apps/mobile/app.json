{
  "expo": {
    "name": "Tamarind Billing",
    "slug": "tamarind-billing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tamarind",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tamarind.billing",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Connect to ESC/POS thermal printers for weight slips and bills.",
        "NSBluetoothPeripheralUsageDescription": "Connect to ESC/POS thermal printers for weight slips and bills."
      }
    },
    "android": {
      "package": "com.tamarind.billing",
      "adaptiveIcon": {
        "backgroundColor": "#1B4332",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
