{
  "name": "tamarind-billing",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tamarind/web",
    "dev:web": "npm run dev -w @tamarind/web",
    "dev:mobile": "npm run start -w @tamarind/mobile",
    "build": "npm run build -w @tamarind/web",
    "test": "npm run test -w @tamarind/core && npm run test -w @tamarind/web",
    "test:core": "npm run test -w @tamarind/core",
    "test:web": "npm run test -w @tamarind/web",
    "typecheck": "npm run typecheck -w @tamarind/core && npm run typecheck -w @tamarind/web",
    "lint": "npm run typecheck"
  },
  "engines": {
    "node": ">=20"
  }
}
